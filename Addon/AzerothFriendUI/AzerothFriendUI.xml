    <!-- 5. Cognitive Mindset & Debug Telemetry Frame -->
    <Frame name="AzerothFriendMemoryFrame" parent="UIParent" movable="true" enableMouse="true" resizable="true" frameStrata="HIGH" hidden="true">
        <Size><AbsDimension x="360" y="220"/></Size>
        <Anchors>
            <Anchor point="TOPLEFT" relativeTo="AzerothFriendEnvFrame" relativePoint="BOTTOMLEFT" x="0" y="-15"/>
