<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- 1. Bot State Frame -->
    <Frame name="AzerothFriendStateFrame" parent="UIParent" movable="true" enableMouse="true" resizable="true" frameStrata="HIGH" hidden="true">
        <Size><AbsDimension x="360" y="220"/></Size>
        <Anchors>
            <Anchor point="TOPLEFT" x="50" y="-120"/>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
            <BackgroundInsets><AbsInset left="4" right="4" top="4" bottom="4"/></BackgroundInsets>
            <TileSize><AbsValue val="16"/></TileSize>
            <EdgeSize><AbsValue val="16"/></EdgeSize>
        </Backdrop>
        <Frames>
            <Frame name="AzerothFriendStateFrameTitleBar" parentKey="TitleBar" enableMouse="true">
                <Anchors>
                    <Anchor point="TOPLEFT" x="4" y="-4"/>
                    <Anchor point="TOPRIGHT" x="-4" y="-4"/>
                </Anchors>
                <Size><AbsDimension x="0" y="24"/></Size>
                <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background-Dark" tile="true">
                    <TileSize><AbsValue val="16"/></TileSize>
                </Backdrop>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="AzerothFriendStateFrameTitle" inherits="GameFontNormal" text="AzerothFriend: Bot State">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Button name="AzerothFriendStateFrameCloseBtn" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="2" y="2"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        self:GetParent():Hide();
                    </OnClick>
                </Scripts>
            </Button>
            <ScrollFrame name="AzerothFriendStateScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="12" y="-32"/>
                    <Anchor point="BOTTOMRIGHT" x="-28" y="10"/>
                </Anchors>
                <ScrollChild>
                    <Frame name="AzerothFriendStateFrameHTML">
                        <Size><AbsDimension x="310" y="170"/></Size>
                        <Layers>
                            <Layer level="ARTWORK">
                                <FontString name="AzerothFriendStateFrameHTMLText" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
                                    <Size><AbsDimension x="310" y="0"/></Size>
                                    <Anchors>
                                        <Anchor point="TOPLEFT" x="0" y="0"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
    </Frame>

    <!-- 2. Cognitive Thoughts & LLM Reasoning Frame -->
    <Frame name="AzerothFriendThoughtFrame" parent="UIParent" movable="true" enableMouse="true" resizable="true" frameStrata="HIGH" hidden="true">
        <Size><AbsDimension x="360" y="170"/></Size>
