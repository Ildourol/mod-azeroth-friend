                    <TileSize><AbsValue val="16"/></TileSize>
                </Backdrop>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="AzerothFriendActionFrameTitle" inherits="GameFontNormal" text="AzerothFriend: Action Pipeline">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Button name="AzerothFriendActionFrameCloseBtn" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="2" y="2"/>
                </Anchors>
                <Scripts>
                    <OnClick>
