                    </OnClick>
                </Scripts>
            </Button>
            <ScrollFrame name="AzerothFriendActionScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="12" y="-32"/>
                    <Anchor point="BOTTOMRIGHT" x="-28" y="10"/>
                </Anchors>
                <ScrollChild>
                    <Frame name="AzerothFriendActionFrameHTML">
                        <Size><AbsDimension x="310" y="90"/></Size>
                        <Layers>
                            <Layer level="ARTWORK">
                                <FontString name="AzerothFriendActionFrameHTMLText" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
                                    <Size><AbsDimension x="310" y="0"/></Size>
                                    <Anchors>
                                        <Anchor point="TOPLEFT" x="0" y="0"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
    </Frame>

    <!-- 4. Environment & Nearby Entities Frame -->
