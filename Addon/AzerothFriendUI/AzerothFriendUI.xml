        <Frames>
            <Frame name="AzerothFriendThoughtFrameTitleBar" parentKey="TitleBar" enableMouse="true">
                <Anchors>
                    <Anchor point="TOPLEFT" x="4" y="-4"/>
                    <Anchor point="TOPRIGHT" x="-4" y="-4"/>
                </Anchors>
                <Size><AbsDimension x="0" y="24"/></Size>
                <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background-Dark" tile="true">
                    <TileSize><AbsValue val="16"/></TileSize>
                </Backdrop>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="AzerothFriendThoughtFrameTitle" inherits="GameFontNormal" text="AzerothFriend: Cognitive Thoughts">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Button name="AzerothFriendThoughtFrameCloseBtn" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="2" y="2"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        self:GetParent():Hide();
                    </OnClick>
                </Scripts>
            </Button>
            <ScrollFrame name="AzerothFriendThoughtScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="12" y="-32"/>
                    <Anchor point="BOTTOMRIGHT" x="-28" y="10"/>
                </Anchors>
                <ScrollChild>
                    <Frame name="AzerothFriendThoughtFrameHTML">
                        <Size><AbsDimension x="310" y="120"/></Size>
                        <Layers>
                            <Layer level="ARTWORK">
                                <FontString name="AzerothFriendThoughtFrameHTMLText" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
                                    <Size><AbsDimension x="310" y="0"/></Size>
                                    <Anchors>
                                        <Anchor point="TOPLEFT" x="0" y="0"/>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
    </Frame>

    <!-- 3. Action Pipeline Frame -->
